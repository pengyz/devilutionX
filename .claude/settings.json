{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-core-files.sh",
            "statusMessage": "检查核心文件保护..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-git-push.sh",
            "statusMessage": "检查 Git push 安全..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-line-endings.sh",
            "statusMessage": "检查行尾合规..."
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-core-files.sh",
            "statusMessage": "检查核心文件保护..."
          }
        ]
      }
    ]
  }
}
