+	const std::vector<LevelRosterEntry> entries { { 1, MT_DIABLO, LevelRosterRole::Core, false } };
+	const std::vector<LevelRosterParams> params { { 1, 6000, 2, {} } };
+	const auto error = ValidateLevelRoster(entries, params);
